{
  "manifest_version": 3,
  "name": "TerminalCanvas Design Mode",
  "version": "1.1.0",
  "description": "Seleccioná un elemento de la página para enviarlo al agente de TerminalCanvas.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TerminalCanvas Design Mode"
  }
}
